map $http_x_request_id $correlation_id {
    default $request_id;
    "~^[A-Za-z0-9._-]{1,64}$" $http_x_request_id;
}
log_format partner escape=json '{"timestamp":"$time_iso8601","service":"frontend","event":"http.request","request_id":"$correlation_id","method":"$request_method","path":"$uri","status":$status,"duration_seconds":$request_time}';
access_log /dev/stdout partner;
error_log /dev/stderr warn;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 25m;

    add_header X-Request-ID $correlation_id always;
    proxy_hide_header X-Request-ID;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location = /admin/ {
        return 301 /admin;
    }

    location = /admin {
        proxy_pass ${RAG_UPSTREAM}/admin;
        proxy_set_header X-Request-ID $correlation_id;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ^~ /api/v1/admin/ {
        proxy_pass ${RAG_UPSTREAM};
        proxy_set_header X-Request-ID $correlation_id;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        client_max_body_size 50m;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/v1/auth/ {
        proxy_pass http://auth:8002;
        proxy_set_header X-Request-ID $correlation_id;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v1/ {
        proxy_pass ${AGENT_UPSTREAM};
        proxy_set_header X-Request-ID $correlation_id;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        # Inherit server diagnostics/security response headers.
    }
}
