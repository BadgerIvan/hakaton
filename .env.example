POSTGRES_DB=partner
POSTGRES_USER=partner
# Use a URL-safe password; percent-encode special characters in DATABASE_URL if configuring manually.
POSTGRES_PASSWORD=partner_local_password
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
LLM_MODEL=qwen3:4b
EMBED_MODEL=bge-m3
EMBED_DIM=1024
HISTORY_TURNS=10
HISTORY_MAX_CHARS=12000
RAG_HISTORY_LIMIT=20
NUM_CTX=8192
GENERATION_TIMEOUT=110
# Optional, for compose.migrate.yaml only:
# SQLITE_AUTH_PATH=./legacy/auth.db

# To reuse existing volumes, copy exact names from `docker volume ls`:
# OLLAMA_VOLUME_NAME=rag_service_ollama_models
# QDRANT_VOLUME_NAME=rag_service_qdrant_storage
