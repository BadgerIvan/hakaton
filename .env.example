# Для Docker Compose. Скопируйте в .env при изменении настроек.
AGENT_UPSTREAM=http://host.docker.internal:8000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
# Для общей PostgreSQL вместо SQLite раскомментируйте и укажите свои реквизиты.
# DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/partner_auth
